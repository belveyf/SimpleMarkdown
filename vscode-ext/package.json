{
  "name": "smd",
  "displayName": "Simple Markdown",
  "description": "用本地 Simple Markdown 一键打开并美化渲染 Markdown 文件",
  "version": "1.0.0",
  "publisher": "belvey",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:smd.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "smd.open",
        "title": "用 Simple Markdown 打开",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "smd.open",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "smd.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "smd.open",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "win": "ctrl+alt+m",
        "linux": "ctrl+alt+m"
      }
    ],
    "configuration": {
      "title": "Simple Markdown",
      "properties": {
        "smd.appPath": {
          "type": "string",
          "default": "",
          "description": "Simple Markdown.app 的完整路径；留空则自动在 ~/Applications 与 /Applications 中查找"
        }
      }
    }
  }
}
